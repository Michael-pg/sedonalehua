# Copy to .env for local development.
# While unset, the app runs against Mock.shop automatically.

# Required for sessions (any random string locally).
SESSION_SECRET="foobar"

# Populated automatically by `npx shopify hydrogen link` once a real
# Shopify store is connected. Leave unset to use Mock.shop.
# PUBLIC_STORE_DOMAIN="your-store.myshopify.com"
# PUBLIC_STOREFRONT_API_TOKEN=""
# PUBLIC_STOREFRONT_ID=""
